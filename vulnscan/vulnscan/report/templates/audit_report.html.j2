<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Security Audit Report – {{ r.meta.target }}</title>
<style>
  @page {
    size: A4; margin: 20mm 18mm 18mm;
    @top-left { content: "Information Security Audit Report"; font-size: 8px; color: #8a94a6; }
    @top-right { content: "Confidential"; font-size: 8px; color: #b42318; letter-spacing: .05em; }
    @bottom-left { content: "VulnScan · Report {{ r.meta.scan_id }}"; font-size: 8px; color: #8a94a6; }
    @bottom-right { content: "Page " counter(page) " / " counter(pages); font-size: 8px; color: #8a94a6; }
  }
  @page :first { @top-left { content: ""; } @top-right { content: ""; } }
  :root { --ink:#16202e; --muted:#5b6678; --line:#dde3ec; --soft:#f4f6fa; --navy:#1b2a4a; --accent:#2d4a86;
          --good:#067647; --warn:#b08800; --bad:#b42318; }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { font-family: "Inter","Segoe UI","DejaVu Sans",Arial,sans-serif; color: var(--ink); margin: 0; font-size: 12px; line-height: 1.55; background:#fff; }
  .wrap { max-width: 900px; margin: 0 auto; padding: 0 20px 60px; }
  h1,h2,h3,h4 { font-family: "Space Grotesk","Inter",sans-serif; color: var(--navy); }
  .muted { color: var(--muted); }
  table { width: 100%; border-collapse: collapse; font-size: 11px; margin: 8px 0; }
  th,td { text-align: left; padding: 7px 9px; border: 1px solid var(--line); vertical-align: top; }
  th { background: var(--soft); font-size: 9.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 700; }
  tr { page-break-inside: avoid; } thead { display: table-header-group; }

  /* cover */
  .cover { height: 247mm; display: flex; flex-direction: column; page-break-after: always; position: relative; padding-top: 30mm; }
  .cover .band { position: absolute; top: 0; left: -50vw; right: -50vw; height: 8px; background: linear-gradient(90deg,#1b2a4a,#2d4a86,#2bbcd6); }
  .cover .mark { display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 800; font-family:"Space Grotesk",sans-serif; color: var(--navy); }
  .cover .mark svg { width: 34px; height: 34px; }
  .cover .kicker { margin-top: 70mm; font-size: 12px; letter-spacing: .3em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .cover h1 { font-size: 40px; line-height: 1.08; margin: 8px 0 4px; letter-spacing: -.02em; }
  .cover .target { font-size: 16px; color: var(--muted); word-break: break-all; }
  .cover .meta { margin-top: auto; border-top: 2px solid var(--navy); padding-top: 14px; display: grid; grid-template-columns: 1fr 1fr; gap: 6px 30px; font-size: 11px; }
  .cover .meta b { color: var(--muted); font-weight: 600; display: inline-block; min-width: 120px; }
  .classif { display: inline-block; border: 1.5px solid var(--bad); color: var(--bad); padding: 3px 12px; border-radius: 4px; font-weight: 700; font-size: 11px; letter-spacing: .08em; }

  h2.sec { font-size: 18px; margin: 30px 0 10px; padding-bottom: 7px; border-bottom: 2px solid var(--navy); counter-increment: sec; }
  h2.sec::before { content: counter(sec) ".  "; color: var(--accent); }
  body { counter-reset: sec; }
  h3 { font-size: 14px; margin: 18px 0 6px; }

  .opinion { display: flex; gap: 20px; align-items: center; background: var(--soft); border: 1px solid var(--line); border-left: 5px solid var(--accent); border-radius: 8px; padding: 16px 18px; }
  .opinion .verdict { font-size: 22px; font-weight: 800; font-family:"Space Grotesk",sans-serif; }
  .score-badge { width: 92px; height: 92px; border-radius: 50%; flex: 0 0 auto; display: grid; place-items: center; text-align: center;
    background: conic-gradient(var(--sc) calc(var(--p)*1%), #e6eaf2 0); position: relative; }
  .score-badge::before { content: ""; position: absolute; inset: 8px; border-radius: 50%; background: #fff; }
  .score-badge b { position: relative; font-size: 24px; font-weight: 800; } .score-badge span { position: relative; font-size: 8px; color: var(--muted); text-transform: uppercase; }
  .stat-row { display: flex; gap: 10px; margin: 14px 0; flex-wrap: wrap; }
  .kpi { flex: 1 1 110px; border: 1px solid var(--line); border-radius: 8px; padding: 12px; text-align: center; }
  .kpi b { display: block; font-size: 24px; font-weight: 800; font-family:"Space Grotesk",sans-serif; }
  .kpi span { font-size: 9.5px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }

  .posture { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .p-strong { background: #e3f6ec; color: var(--good); } .p-fair { background: #fdf4e3; color: var(--warn); }
  .p-weak { background: #fdeceb; color: var(--bad); } .p-insufficient-data { background: #eef1f6; color: var(--muted); }
  .bar { height: 8px; background: #e6eaf2; border-radius: 5px; overflow: hidden; min-width: 90px; }
  .bar i { display: block; height: 100%; border-radius: 5px; }
  .sev { font-weight: 700; } .s-critical { color: var(--bad); } .s-high { color: #d9480f; } .s-medium { color: var(--warn); } .s-low { color: #1d6fb8; } .s-info { color: var(--muted); }
  .status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; }
  .d-gap { background: var(--bad); } .d-pass { background: var(--good); } .d-not_assessed { background: #c2c9d6; }
  .tag { display: inline-block; background: var(--soft); border: 1px solid var(--line); border-radius: 5px; padding: 0 6px; font-size: 9.5px; color: var(--accent); margin: 1px 2px 1px 0; }
  .callout { background: var(--soft); border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; margin: 10px 0; }
  .fw-block { page-break-inside: avoid; margin: 14px 0; }
  .finding-card { border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px; margin: 10px 0; page-break-inside: avoid; }
  .finding-card h4 { margin: 0 0 4px; font-size: 12.5px; }
  .finding-card .loc { font-family: "JetBrains Mono",monospace; font-size: 10px; color: var(--muted); word-break: break-all; }
  .finding-card pre { background: #0d1526; color: #e4e9f2; padding: 8px 10px; border-radius: 6px; font-size: 9.5px; white-space: pre-wrap; word-break: break-word; max-height: 150px; overflow: hidden; }
  .lbl { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); margin-top: 8px; }
  .signoff { margin-top: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  .signoff .line { border-top: 1px solid var(--ink); padding-top: 6px; font-size: 10px; color: var(--muted); margin-top: 34px; }
  .toc { columns: 2; font-size: 11px; } .toc div { margin: 3px 0; }
  .disclaimer { font-size: 10px; color: var(--muted); border-top: 1px solid var(--line); padding-top: 10px; margin-top: 24px; }
</style>
</head>
<body>
<div class="wrap">

  {% set a_overall = a.overall if a.overall is not none else 0 %}
  {% set sc_col = "#067647" if a.overall is not none and a.overall>=80 else ("#b08800" if a.overall is not none and a.overall>=50 else "#b42318") %}

  <!-- ============ COVER ============ -->
  <section class="cover">
    <div class="band"></div>
    <div class="mark">
      <svg viewBox="0 0 32 32"><path d="M16 2 4 7v8c0 7.5 5.1 13.6 12 15 6.9-1.4 12-7.5 12-15V7z" fill="#1b2a4a"/><path d="m10.5 16 4 4 7-8" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      VulnScan
    </div>
    <div class="kicker">Information Security &amp; Compliance</div>
    <h1>Security Audit Report</h1>
    <div class="target">{{ r.meta.target }}</div>
    <div style="margin-top:18px"><span class="classif">CONFIDENTIAL</span></div>
    <div class="meta">
      <div><b>Report ID</b> AUD-{{ r.meta.scan_id }}</div>
      <div><b>Report date</b> {{ r.meta.finished_at[:10] }}</div>
      <div><b>Assessment type</b> {{ r.meta.kind | upper }} · {{ r.meta.profile }} profile</div>
      <div><b>Overall opinion</b> {{ a.opinion }}</div>
      <div><b>Prepared by</b> VulnScan Automated Audit Engine v{{ version }}</div>
      <div><b>Frameworks</b> {{ a.frameworks | length }} assessed</div>
      <div><b>Standards</b> OWASP · NIST · CIS · ISO 27001 · PCI DSS · SOC 2 · GDPR · HIPAA</div>
      <div><b>Distribution</b> Named recipient only</div>
    </div>
  </section>

  <!-- ============ DOCUMENT CONTROL ============ -->
  <h2 class="sec">Document Control</h2>
  <table>
    <tr><th>Field</th><th>Detail</th></tr>
    <tr><td>Document title</td><td>Security Audit Report — {{ r.meta.target }}</td></tr>
    <tr><td>Classification</td><td>Confidential</td></tr>
    <tr><td>Version</td><td>1.0 (automated issue)</td></tr>
    <tr><td>Status</td><td>Final</td></tr>
    <tr><td>Author</td><td>VulnScan Automated Audit Engine v{{ version }}</td></tr>
    <tr><td>Assessment window</td><td>{{ r.meta.started_at[:19] | replace("T"," ") }} → {{ r.meta.finished_at[:19] | replace("T"," ") }} UTC</td></tr>
    <tr><td>Target of evaluation</td><td style="word-break:break-all">{{ r.meta.target }}</td></tr>
  </table>
  <div class="toc">
    <div>1. Document Control</div><div>2. Executive Summary</div><div>3. Scope &amp; Objectives</div>
    <div>4. Methodology &amp; Standards</div><div>5. Compliance Posture Summary</div><div>6. Detailed Framework Assessment</div>
    <div>7. Gap Register</div><div>8. Remediation Roadmap</div><div>9. Detailed Findings</div>
    <div>10. Limitations &amp; Disclaimer</div>
  </div>

  <!-- ============ EXECUTIVE SUMMARY ============ -->
  <h2 class="sec">Executive Summary</h2>
  <div class="opinion">
    <div class="score-badge" style="--p:{{ a_overall }}; --sc:{{ sc_col }}"><b style="color:{{ sc_col }}">{{ (a.overall ~ '%') if a.overall is not none else 'N/A' }}</b><span>posture</span></div>
    <div>
      <div class="muted" style="font-size:10px;text-transform:uppercase;letter-spacing:.08em">Overall audit opinion</div>
      <div class="verdict" style="color:{{ sc_col }}">{{ a.opinion }}</div>
      <div class="muted">Weighted compliance posture across {{ a.frameworks | length }} frameworks, based on the {{ a.total_assessed }} controls this assessment was able to evaluate automatically.</div>
    </div>
  </div>
  <div class="stat-row">
    {% set c = r.summary.counts %}
    <div class="kpi"><b class="s-critical">{{ c.critical }}</b><span>Critical</span></div>
    <div class="kpi"><b class="s-high">{{ c.high }}</b><span>High</span></div>
    <div class="kpi"><b class="s-medium">{{ c.medium }}</b><span>Medium</span></div>
    <div class="kpi"><b>{{ a.total_gaps }}</b><span>Control gaps</span></div>
    <div class="kpi"><b>{{ r.summary.accuracy.mean_confidence }}%</b><span>Mean confidence</span></div>
  </div>
  <p>{{ r.summary.executive_summary }}</p>
  <div class="callout">
    <b>Auditor's note on evidence quality.</b> Each finding in this report carries a confidence score derived from tool
    reliability, cross-tool corroboration, exploit intelligence (EPSS / CISA KEV) and automated triage.
    {{ r.summary.accuracy.high_confidence_pct }}% of open findings are high-confidence; {{ r.summary.accuracy.flagged_false_positives }}
    item(s) were assessed as likely false positives and are excluded from the posture scoring above.
  </div>

  <!-- ============ SCOPE ============ -->
  <h2 class="sec">Scope &amp; Objectives</h2>
  <p>This audit evaluated the security posture of the target of evaluation and its mapping to recognised control
     frameworks. The objective was to provide an independent, evidence-based view of (a) exploitable technical
     vulnerabilities and (b) the degree to which implemented controls satisfy common compliance requirements.</p>
  <table>
    <tr><th style="width:38%">Item</th><th>In scope</th></tr>
    <tr><td>Target</td><td style="word-break:break-all">{{ r.meta.target }}</td></tr>
    <tr><td>Assessment type</td><td>{{ r.meta.kind | upper }} ({{ 'source code' if r.meta.kind in ['repo','zip'] else 'running application / host' }})</td></tr>
    {% if r.recon.languages %}<tr><td>Technologies observed</td><td>{{ r.recon.languages | dictsort(false,'value') | reverse | map(attribute=0) | join(', ') }}{% if r.recon.frameworks %} · {{ r.recon.frameworks | join(', ') }}{% endif %}</td></tr>{% endif %}
    {% if r.recon.uses_llm %}<tr><td>AI / LLM components</td><td>Present — assessed against the OWASP Top 10 for LLM Applications</td></tr>{% endif %}
    <tr><td>Frameworks assessed</td><td>{% for name,fw in a.frameworks %}{{ name }}{% if not loop.last %}; {% endif %}{% endfor %}</td></tr>
  </table>

  <!-- ============ METHODOLOGY ============ -->
  <h2 class="sec">Methodology &amp; Standards</h2>
  <p>The assessment was performed using an automated, multi-tool pipeline. Each tool's output was normalised to a
     common schema, de-duplicated, enriched with vulnerability intelligence, triaged for false positives and mapped
     to control frameworks. The approach aligns with the OWASP Testing Guide and risk-based audit principles.</p>
  <h3>Tools used</h3>
  <table><tr><th>Tool</th><th>Status</th><th>Findings</th></tr>
    {% for t in r.tool_runs | sort(attribute="tool") if t.status == "ok" %}
    <tr><td>{{ t.tool }}</td><td>Completed</td><td>{{ t.findings }}</td></tr>
    {% endfor %}
  </table>
  <h3>Rating definitions</h3>
  <table>
    <tr><th>Posture</th><th>Meaning</th></tr>
    <tr><td><span class="posture p-strong">Strong</span></td><td>≥ 80% of assessed controls satisfied.</td></tr>
    <tr><td><span class="posture p-fair">Fair</span></td><td>50–79% of assessed controls satisfied; remediation recommended.</td></tr>
    <tr><td><span class="posture p-weak">Weak</span></td><td>&lt; 50% of assessed controls satisfied; priority remediation required.</td></tr>
    <tr><td><span class="posture p-insufficient-data">Insufficient data</span></td><td>Area could not be assessed by automated means.</td></tr>
  </table>

  <!-- ============ POSTURE SUMMARY ============ -->
  <h2 class="sec">Compliance Posture Summary</h2>
  <table>
    <tr><th>Framework</th><th>Posture</th><th>Score</th><th style="width:120px">Controls</th><th>Assessed</th><th>Gaps</th></tr>
    {% for name,fw in a.frameworks %}
    {% set col = "#067647" if fw.score is not none and fw.score>=80 else ("#b08800" if fw.score is not none and fw.score>=50 else "#b42318") %}
    <tr>
      <td><b>{{ name }}</b><div class="muted" style="font-size:9.5px">{{ fw.desc }}</div></td>
      <td><span class="posture p-{{ fw.posture }}">{{ fw.posture | replace("-"," ") }}</span></td>
      <td>{% if fw.score is not none %}<b style="color:{{ col }}">{{ fw.score }}%</b><div class="bar" style="margin-top:3px"><i style="width:{{ fw.score }}%;background:{{ col }}"></i></div>{% else %}—{% endif %}</td>
      <td>{{ fw.total }}</td><td>{{ fw.assessed }}</td>
      <td>{% if fw.gaps %}<b class="s-high">{{ fw.gaps }}</b>{% else %}0{% endif %}</td>
    </tr>
    {% endfor %}
  </table>

  <!-- ============ DETAILED FRAMEWORK ASSESSMENT ============ -->
  <h2 class="sec">Detailed Framework Assessment</h2>
  {% for name,fw in a.frameworks %}
  <div class="fw-block">
    <h3>{{ name }} <span class="posture p-{{ fw.posture }}" style="vertical-align:middle">{{ fw.posture | replace("-"," ") }}{% if fw.score is not none %} · {{ fw.score }}%{% endif %}</span></h3>
    <table>
      <tr><th style="width:70px">Control</th><th>Requirement</th><th style="width:90px">Status</th><th style="width:70px">Findings</th></tr>
      {% for ct in fw.controls %}
      <tr>
        <td><b>{{ ct.id }}</b></td>
        <td>{{ ct.title }}<div class="muted" style="font-size:9.5px">{{ ct.summary }}</div></td>
        <td><span class="status-dot d-{{ ct.status }}"></span>{{ "Gap" if ct.status=="gap" else ("Satisfied" if ct.status=="pass" else "Not assessed") }}</td>
        <td>{% if ct.finding_count %}<span class="sev s-{{ ct.max_severity }}">{{ ct.finding_count }} ({{ ct.max_severity }})</span>{% else %}—{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
  {% endfor %}

  <!-- ============ GAP REGISTER ============ -->
  <h2 class="sec">Gap Register</h2>
  <p class="muted">All control gaps identified during the assessment, ordered by severity. Each maps to one or more findings in Section 9.</p>
  {% if a.gaps %}
  <table>
    <tr><th style="width:30px">#</th><th>Framework</th><th>Control</th><th>Requirement</th><th style="width:70px">Severity</th><th style="width:55px">Items</th></tr>
    {% for g in a.gaps %}
    <tr><td>{{ loop.index }}</td><td>{{ g.framework }}</td><td><b>{{ g.control }}</b></td><td>{{ g.title }}</td>
      <td><span class="sev s-{{ g.max_severity }}">{{ g.max_severity | capitalize }}</span></td><td>{{ g.count }}</td></tr>
    {% endfor %}
  </table>
  {% else %}<div class="callout">No control gaps were identified within the assessed scope.</div>{% endif %}

  <!-- ============ REMEDIATION ROADMAP ============ -->
  <h2 class="sec">Remediation Roadmap</h2>
  <p class="muted">Prioritised, actionable remediation for the open findings, highest risk first.</p>
  {% if a.roadmap %}
  <table>
    <tr><th style="width:26px">#</th><th style="width:70px">Priority</th><th>Finding</th><th>Recommended action</th><th>Controls</th></tr>
    {% for item in a.roadmap %}
    <tr>
      <td>{{ item.n }}</td>
      <td><span class="sev s-{{ item.severity }}">{{ item.priority }}</span></td>
      <td>{{ item.title }}<div class="loc muted" style="font-size:9.5px;font-family:monospace">{{ item.location }}</div></td>
      <td>{{ item.action[:300] }}</td>
      <td>{% for fw in item.frameworks[:4] %}<span class="tag">{{ fw }}</span>{% endfor %}</td>
    </tr>
    {% endfor %}
  </table>
  {% else %}<div class="callout">No remediation actions required within the assessed scope.</div>{% endif %}

  <!-- ============ DETAILED FINDINGS ============ -->
  <h2 class="sec">Detailed Findings</h2>
  <p class="muted">Technical detail for each open finding, with evidence, confidence rating and control mapping. {{ a.open_findings | length }} finding(s).</p>
  {% for f in a.open_findings %}
  <div class="finding-card">
    <h4><span class="sev s-{{ f.severity }}">[{{ f.severity | upper }}]</span> {{ f.title }}</h4>
    <div class="loc">{{ f.location.file or f.location.url or f.location.host or f.location.component or "-" }}{% if f.location.line %}:{{ f.location.line }}{% endif %}{% if f.location.param %} · parameter {{ f.location.param }}{% endif %}</div>
    <div style="margin-top:5px">
      {% for o in f.owasp %}<span class="tag">{{ o }}</span>{% endfor %}{% for o in f.owasp_llm %}<span class="tag">{{ o }}</span>{% endfor %}
      {% for w in f.cwe %}<span class="tag">{{ w }}</span>{% endfor %}{% for v in f.cve[:4] %}<span class="tag">{{ v }}</span>{% endfor %}
      <span class="tag">confidence {{ f.confidence_score }}% · {{ f.verdict | replace("_"," ") }}</span>{% if f.kev %}<span class="tag" style="color:#b42318">CISA KEV</span>{% endif %}
    </div>
    {% if f.description %}<div class="lbl">Observation</div><div>{{ f.description[:900] }}</div>{% endif %}
    {% if f.evidence %}<div class="lbl">Evidence</div><pre>{{ f.evidence[:700] }}</pre>{% endif %}
    {% if f.remediation %}<div class="lbl">Recommendation</div><div>{{ f.remediation }}{% if f.fixed_version %} Fixed in {{ f.fixed_version }}.{% endif %}</div>{% endif %}
    {% if f.frameworks %}<div class="lbl">Control impact</div><div>{% for x in f.frameworks %}<span class="tag">{{ x }}</span>{% endfor %}</div>{% endif %}
  </div>
  {% endfor %}

  <!-- ============ DISCLAIMER ============ -->
  <h2 class="sec">Limitations &amp; Disclaimer</h2>
  <p>This report reflects the results of automated security testing performed during the assessment window stated in
     Section 1. Automated assessment cannot evaluate every control: organisational, physical, personnel and
     procedural controls (marked <i>not assessed</i>) require review by a qualified human auditor and supporting
     documentation. A clean automated result is not a guarantee of the absence of vulnerabilities, nor does a framework
     score constitute formal certification against that standard. Compliance determinations (e.g. ISO 27001 certification,
     PCI DSS attestation, SOC 2 opinion) can only be issued by an accredited assessor. Findings should be validated in
     the target environment before remediation.</p>
  <div class="signoff">
    <div><div class="line">Assessed by — VulnScan Automated Audit Engine</div></div>
    <div><div class="line">Reviewed by — (human auditor signature)</div></div>
  </div>
  <div class="disclaimer">
    VulnScan {{ version }} · Report AUD-{{ r.meta.scan_id }} · Generated {{ r.meta.finished_at[:19] | replace("T"," ") }} UTC ·
    Confidential — distribute only to named recipients. © The target's owner. This document contains security-sensitive information.
  </div>

</div>
</body>
</html>
